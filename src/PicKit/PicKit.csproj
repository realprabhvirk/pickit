<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>PicKit</RootNamespace>
    <AssemblyName>PicKit</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PicKit.ico</ApplicationIcon>
    <!-- The Fluent theme is still marked experimental; it is the native look this app wants. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <TieredPGO>false</TieredPGO>
    <!-- Images live outside the managed heap, so a background collector thread earns nothing here. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
    <!-- Measured: compiling the app and framework together starts about 240 ms faster. -->
    <PublishReadyToRunComposite Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRunComposite>
    <!-- Program.cs owns Main so a second launch can hand off without starting WPF. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PicKit.Core\PicKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PicKit.UiTests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PicKit.ico" />
    <!-- Windows reads this file for the icon on notifications. -->
    <None Include="Assets\PicKit.ico" Link="PicKit.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The model lives outside the source tree. Builds carry it along when it has been fetched. -->
  <ItemGroup Condition="Exists('$(ArtifactsPath)\models\isnet-general-use.onnx')">
    <None Include="$(ArtifactsPath)\models\isnet-general-use.onnx" Link="models\isnet-general-use.onnx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
