<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:imaging="clr-namespace:PicKit.Core.Imaging;assembly=PicKit.Core"
    xmlns:segmentation="clr-namespace:PicKit.Core.Segmentation;assembly=PicKit.Core"
    xmlns:tools="clr-namespace:PicKit.ViewModels.Tools">

    <DataTemplate DataType="{x:Type tools:CropToolViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Aspect ratio" />
            <ListBox
                AutomationProperties.Name="Aspect ratio"
                ItemContainerStyle="{StaticResource ChipItem}"
                ItemsSource="{Binding Aspects}"
                SelectedItem="{Binding SelectedAspect}"
                Style="{StaticResource PlainList}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Margin="0,6,0,0" Visibility="{Binding IsCustomAspect, Converter={StaticResource BooleanToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox AutomationProperties.Name="Custom ratio width" Text="{Binding CustomWidth, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="8,0"
                    VerticalAlignment="Center"
                    Text=":" />
                <TextBox
                    Grid.Column="2"
                    AutomationProperties.Name="Custom ratio height"
                    Text="{Binding CustomHeight, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Button
                Margin="0,10,0,0"
                HorizontalAlignment="Left"
                Command="{Binding SwapOrientationCommand}"
                Content="Swap orientation"
                ToolTip="Switch between landscape and portrait" />

            <TextBlock Margin="0,16,0,2" Style="{StaticResource SecondaryText}" Text="Size after crop" />
            <TextBlock FontSize="14" Text="{Binding SizeText}" />

            <TextBlock
                Margin="0,14,0,0"
                Style="{StaticResource BodyHint}"
                Text="Drag the corners or edges, or drag inside the box to move it." />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    HorizontalAlignment="Stretch"
                    Command="{Binding CancelCommand}"
                    Content="Cancel" />
                <Button
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ApplyCommand}"
                    Content="Apply Crop"
                    Style="{DynamicResource AccentButtonStyle}" />
            </Grid>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type tools:ResizeToolViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Mode" />
            <RadioButton
                Content="Scale"
                GroupName="ResizeMode"
                IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter={x:Static imaging:ResizeMode.Scale}}" />
            <RadioButton
                Content="Fit"
                GroupName="ResizeMode"
                IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter={x:Static imaging:ResizeMode.Fit}}" />
            <RadioButton
                Content="Crop to fill"
                GroupName="ResizeMode"
                IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter={x:Static imaging:ResizeMode.CropToFill}}" />
            <TextBlock
                Margin="0,6,0,0"
                Style="{StaticResource BodyHint}"
                Text="{Binding ModeDescription}" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Width" />
                    <TextBox AutomationProperties.Name="Width" Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Height" />
                    <TextBox AutomationProperties.Name="Height" Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <CheckBox
                Margin="0,10,0,0"
                Content="Keep aspect ratio"
                IsChecked="{Binding KeepAspect}"
                Visibility="{Binding ShowsKeepAspect, Converter={StaticResource BooleanToVisibility}}" />

            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource WarningText}"
                Text="{Binding Warning}"
                Visibility="{Binding Warning, Converter={StaticResource NullToCollapsed}}" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource SecondaryText}" Text="Original" />
                    <TextBlock Text="{Binding OriginalText}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource SecondaryText}" Text="Result" />
                    <TextBlock Text="{Binding ResultText}" />
                </StackPanel>
            </Grid>

            <TextBlock
                Margin="0,10,0,0"
                Style="{StaticResource SecondaryText}"
                Text="Estimated size" />
            <TextBlock Text="{Binding EstimateText}" />

            <Button
                Margin="0,18,0,0"
                HorizontalAlignment="Stretch"
                Command="{Binding ApplyCommand}"
                Content="Apply"
                Style="{DynamicResource AccentButtonStyle}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type tools:RotateToolViewModel}">
        <StackPanel>
            <Button
                Margin="0,0,0,8"
                HorizontalAlignment="Stretch"
                Command="{Binding RotateLeftCommand}"
                Content="Rotate left" />
            <Button
                Margin="0,0,0,16"
                HorizontalAlignment="Stretch"
                Command="{Binding RotateRightCommand}"
                Content="Rotate right" />
            <Button
                Margin="0,0,0,8"
                HorizontalAlignment="Stretch"
                Command="{Binding FlipHorizontalCommand}"
                Content="Flip horizontal" />
            <Button
                HorizontalAlignment="Stretch"
                Command="{Binding FlipVerticalCommand}"
                Content="Flip vertical" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type tools:PresetToolViewModel}">
        <StackPanel>
            <TextBlock
                Style="{StaticResource BodyHint}"
                Text="Choose where this image is going."
                Visibility="{Binding HasSelection, Converter={StaticResource InverseBooleanToVisibility}}" />

            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding SelectedPreset.Name}" />
                <TextBlock Margin="0,2,0,0" Text="{Binding SelectedPreset.DimensionsText}" />
                <TextBlock Margin="0,0,0,10" Style="{StaticResource SecondaryText}" Text="{Binding SelectedPreset.AspectText}" />
                <TextBlock Style="{StaticResource BodyHint}" Text="{Binding SelectedPreset.Note}" />
                <TextBlock
                    Margin="0,10,0,0"
                    Style="{StaticResource BodyHint}"
                    Text="{Binding CropSummary}" />

                <Button
                    Margin="0,18,0,8"
                    HorizontalAlignment="Stretch"
                    Command="{Binding CropToFitCommand}"
                    Content="Crop to Fit"
                    Style="{DynamicResource AccentButtonStyle}"
                    Visibility="{Binding CanCrop, Converter={StaticResource BooleanToVisibility}}" />
                <Button
                    HorizontalAlignment="Stretch"
                    Command="{Binding FitInsideCommand}"
                    Content="Fit Inside" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type tools:MarkupToolViewModel}">
        <StackPanel>
            <ListBox
                Margin="0,0,0,10"
                AutomationProperties.Name="Drawing tool"
                ItemContainerStyle="{StaticResource ChipItem}"
                ItemsSource="{Binding Modes}"
                SelectedItem="{Binding SelectedMode}"
                Style="{StaticResource PlainList}"
                Visibility="{Binding ShowsModes, Converter={StaticResource BooleanToVisibility}}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel
                            AutomationProperties.Name="{Binding Label}"
                            Orientation="Horizontal"
                            ToolTip="{Binding Label}">
                            <TextBlock Style="{StaticResource IconText}" Text="{Binding Glyph}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Color" />
            <ItemsControl Focusable="False" ItemsSource="{Binding Palette}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Margin="0,0,6,6"
                            AutomationProperties.Name="{Binding Name}"
                            Command="{Binding DataContext.ChooseSwatchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource SwatchButton}"
                            ToolTip="{Binding Name}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button
                Margin="0,2,0,12"
                HorizontalAlignment="Left"
                Command="{Binding ChooseCustomColorCommand}"
                Content="More colors..." />

            <StackPanel Visibility="{Binding ShowsThickness, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Thickness" />
                <Slider
                    AutomationProperties.Name="Thickness"
                    IsSnapToTickEnabled="True"
                    Maximum="40"
                    Minimum="1"
                    TickFrequency="1"
                    Value="{Binding Thickness}" />
            </StackPanel>

            <StackPanel Margin="0,10,0,0" Visibility="{Binding ShowsFontSize, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Font size" />
                <Slider
                    AutomationProperties.Name="Font size"
                    IsSnapToTickEnabled="True"
                    Maximum="200"
                    Minimum="8"
                    TickFrequency="1"
                    Value="{Binding FontSize}" />
            </StackPanel>

            <StackPanel Margin="0,10,0,0" Visibility="{Binding ShowsOpacity, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Opacity" />
                <Slider
                    AutomationProperties.Name="Opacity"
                    Maximum="1"
                    Minimum="0.1"
                    Value="{Binding Opacity}" />
            </StackPanel>

            <TextBlock
                Margin="0,14,0,0"
                Style="{StaticResource BodyHint}"
                Text="{Binding Hint}" />
            <TextBlock
                Margin="0,6,0,0"
                Style="{StaticResource BodyHint}"
                Text="Press Delete to remove the selected item."
                Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type tools:BlurToolViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource BodyHint}" Text="Drag over the area to blur." />
            <TextBlock
                Margin="0,14,0,0"
                Style="{StaticResource FieldLabel}"
                Text="Strength" />
            <Slider
                AutomationProperties.Name="Blur strength"
                IsSnapToTickEnabled="True"
                Maximum="40"
                Minimum="2"
                TickFrequency="1"
                Value="{Binding Strength}" />
            <TextBlock
                Margin="0,14,0,0"
                Style="{StaticResource BodyHint}"
                Text="For passwords or ID numbers, use Redact. Heavy blur is good for faces, but some blurred text can be recovered." />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type tools:PixelateToolViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource BodyHint}" Text="Drag over the area to pixelate." />
            <TextBlock
                Margin="0,14,0,0"
                Style="{StaticResource FieldLabel}"
                Text="Block size" />
            <Slider
                AutomationProperties.Name="Block size"
                IsSnapToTickEnabled="True"
                Maximum="64"
                Minimum="4"
                TickFrequency="1"
                Value="{Binding BlockSize}" />
            <TextBlock
                Margin="0,14,0,0"
                Style="{StaticResource BodyHint}"
                Text="For passwords or ID numbers, use Redact. Small blocks can sometimes be read." />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type tools:RedactToolViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource BodyHint}" Text="{Binding PendingText}" />

            <TextBlock
                Margin="0,14,0,4"
                Style="{StaticResource FieldLabel}"
                Text="Fill" />
            <StackPanel Orientation="Horizontal">
                <RadioButton
                    Margin="0,0,16,0"
                    Content="Black"
                    GroupName="RedactFill"
                    IsChecked="True" />
                <RadioButton
                    Content="White"
                    GroupName="RedactFill"
                    IsChecked="{Binding UseWhite}" />
            </StackPanel>

            <Border
                Margin="0,14,0,0"
                Padding="10,8"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                CornerRadius="4">
                <TextBlock
                    Style="{StaticResource BodyHint}"
                    Text="Redacting permanently replaces these pixels. The hidden content won't be in anything you save or copy. You can undo until you close the image." />
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    HorizontalAlignment="Stretch"
                    Command="{Binding ClearCommand}"
                    Content="Clear" />
                <Button
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ApplyCommand}"
                    Content="Apply"
                    Style="{DynamicResource AccentButtonStyle}" />
            </Grid>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type tools:CompressToolViewModel}">
        <StackPanel>
            <RadioButton
                Content="Choose a quality"
                GroupName="CompressMode"
                IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter={x:Static tools:CompressMode.Quality}}" />
            <RadioButton
                Content="Compress to a target size"
                GroupName="CompressMode"
                IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter={x:Static tools:CompressMode.TargetSize}}" />

            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsQualityMode, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Quality" />
                <RadioButton
                    Content="High"
                    GroupName="CompressQuality"
                    IsChecked="{Binding Preset, Converter={StaticResource Equals}, ConverterParameter={x:Static imaging:CompressionPreset.High}}"
                    IsEnabled="{Binding UsesQuality}" />
                <RadioButton
                    Content="Balanced"
                    GroupName="CompressQuality"
                    IsChecked="{Binding Preset, Converter={StaticResource Equals}, ConverterParameter={x:Static imaging:CompressionPreset.Balanced}}"
                    IsEnabled="{Binding UsesQuality}" />
                <RadioButton
                    Content="Small"
                    GroupName="CompressQuality"
                    IsChecked="{Binding Preset, Converter={StaticResource Equals}, ConverterParameter={x:Static imaging:CompressionPreset.Small}}"
                    IsEnabled="{Binding UsesQuality}" />
            </StackPanel>

            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsTargetMode, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Target size (MB)" />
                <TextBox AutomationProperties.Name="Target size in megabytes" Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <TextBlock
                Margin="0,14,0,0"
                Style="{StaticResource FieldLabel}"
                Text="Format" />
            <ComboBox
                AutomationProperties.Name="Output format"
                DisplayMemberPath="Label"
                ItemsSource="{Binding Formats}"
                SelectedItem="{Binding SelectedFormat}" />
            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource BodyHint}"
                Text="{Binding FormatNote}"
                Visibility="{Binding FormatNote, Converter={StaticResource NullToCollapsed}}" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource SecondaryText}" Text="Original" />
                    <TextBlock Text="{Binding OriginalText}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource SecondaryText}" Text="Estimated" />
                    <TextBlock Text="{Binding EstimateText}" />
                </StackPanel>
            </Grid>

            <Button
                Margin="0,18,0,0"
                HorizontalAlignment="Stretch"
                Command="{Binding CompressCommand}"
                Content="Compress"
                Style="{DynamicResource AccentButtonStyle}" />

            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsCompressing, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Margin="0,0,0,6" Text="Compressing..." />
                <ProgressBar IsIndeterminate="True" />
                <Button
                    Margin="0,8,0,0"
                    Command="{Binding CancelCommand}"
                    Content="Cancel" />
            </StackPanel>

            <TextBlock
                Margin="0,12,0,0"
                Text="{Binding ResultText}"
                TextWrapping="Wrap"
                Visibility="{Binding ResultText, Converter={StaticResource NullToCollapsed}}" />
            <TextBlock
                Margin="0,12,0,0"
                Style="{StaticResource WarningText}"
                Text="{Binding ProblemText}"
                Visibility="{Binding ProblemText, Converter={StaticResource NullToCollapsed}}" />
            <Button
                Margin="0,8,0,0"
                HorizontalAlignment="Left"
                Command="{Binding ShowInFolderCommand}"
                Content="Show in folder"
                Visibility="{Binding CanShowResult, Converter={StaticResource BooleanToVisibility}}" />

            <TextBlock
                Margin="0,14,0,0"
                Style="{StaticResource BodyHint}"
                Text="This saves a new file next to your original." />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type tools:ConvertToolViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Convert to" />
            <ListBox
                AutomationProperties.Name="Format"
                ItemContainerStyle="{StaticResource ChipItem}"
                ItemsSource="{Binding Formats}"
                SelectedItem="{Binding SelectedFormat}"
                Style="{StaticResource PlainList}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Margin="0,10,0,0" Visibility="{Binding UsesQuality, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Quality, StringFormat=Quality: {0:0}}" />
                <Slider
                    AutomationProperties.Name="Quality"
                    IsSnapToTickEnabled="True"
                    Maximum="100"
                    Minimum="30"
                    TickFrequency="1"
                    Value="{Binding Quality}" />
            </StackPanel>

            <StackPanel Margin="0,12,0,0" Visibility="{Binding NeedsFill, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Transparency" />
                <TextBlock
                    Margin="0,0,0,6"
                    Style="{StaticResource BodyHint}"
                    Text="JPEG can't be transparent. Choose what goes behind the image." />
                <RadioButton
                    Content="White"
                    GroupName="ConvertFill"
                    IsChecked="{Binding Fill, Converter={StaticResource Equals}, ConverterParameter={x:Static tools:TransparencyFill.White}}" />
                <RadioButton
                    Content="Black"
                    GroupName="ConvertFill"
                    IsChecked="{Binding Fill, Converter={StaticResource Equals}, ConverterParameter={x:Static tools:TransparencyFill.Black}}" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        Content="Custom"
                        GroupName="ConvertFill"
                        IsChecked="{Binding Fill, Converter={StaticResource Equals}, ConverterParameter={x:Static tools:TransparencyFill.Custom}}" />
                    <Button
                        Margin="8,0,0,0"
                        Command="{Binding ChooseCustomFillCommand}"
                        Content="Choose..." />
                </StackPanel>
            </StackPanel>

            <Button
                Margin="0,18,0,0"
                HorizontalAlignment="Stretch"
                Command="{Binding ConvertCommand}"
                Content="Convert"
                Style="{DynamicResource AccentButtonStyle}" />

            <TextBlock
                Margin="0,12,0,0"
                Text="{Binding ResultText}"
                TextWrapping="Wrap"
                Visibility="{Binding ResultText, Converter={StaticResource NullToCollapsed}}" />
            <TextBlock
                Margin="0,12,0,0"
                Style="{StaticResource WarningText}"
                Text="{Binding ProblemText}"
                Visibility="{Binding ProblemText, Converter={StaticResource NullToCollapsed}}" />
            <Button
                Margin="0,8,0,0"
                HorizontalAlignment="Left"
                Command="{Binding ShowInFolderCommand}"
                Content="Show in folder"
                Visibility="{Binding CanShowResult, Converter={StaticResource BooleanToVisibility}}" />

            <TextBlock
                Margin="0,14,0,0"
                Style="{StaticResource BodyHint}"
                Text="This saves a new file next to your original." />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type tools:DetailsToolViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource BodyHint}" Text="{Binding Summary}" />

            <ItemsControl
                Margin="0,12,0,0"
                Focusable="False"
                ItemsSource="{Binding Fields}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Name}" />
                            <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button
                Margin="0,10,0,0"
                HorizontalAlignment="Stretch"
                Command="{Binding RemoveCommand}"
                Content="Remove details"
                Style="{DynamicResource AccentButtonStyle}"
                Visibility="{Binding CanRemove, Converter={StaticResource BooleanToVisibility}}" />
            <TextBlock
                Margin="0,12,0,0"
                Text="{Binding ResultText}"
                TextWrapping="Wrap"
                Visibility="{Binding ResultText, Converter={StaticResource NullToCollapsed}}" />
            <TextBlock
                Margin="0,12,0,0"
                Style="{StaticResource WarningText}"
                Text="{Binding ProblemText}"
                Visibility="{Binding ProblemText, Converter={StaticResource NullToCollapsed}}" />
            <Button
                Margin="0,8,0,0"
                HorizontalAlignment="Left"
                Command="{Binding ShowInFolderCommand}"
                Content="Show in folder"
                Visibility="{Binding CanShowResult, Converter={StaticResource BooleanToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type tools:BackgroundToolViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource BodyHint}" Text="{Binding StatusText}" />

            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsWorking, Converter={StaticResource BooleanToVisibility}}">
                <ProgressBar IsIndeterminate="True" />
                <Button
                    Margin="0,12,0,0"
                    Command="{Binding CancelCommand}"
                    Content="Cancel" />
            </StackPanel>

            <StackPanel Margin="0,14,0,0" Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Brush" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        Margin="0,0,16,0"
                        Content="+ Keep"
                        GroupName="MaskBrush"
                        IsChecked="{Binding BrushMode, Converter={StaticResource Equals}, ConverterParameter={x:Static segmentation:BrushMode.Keep}}" />
                    <RadioButton
                        Content="- Remove"
                        GroupName="MaskBrush"
                        IsChecked="{Binding BrushMode, Converter={StaticResource Equals}, ConverterParameter={x:Static segmentation:BrushMode.Remove}}" />
                </StackPanel>

                <TextBlock
                    Margin="0,12,0,0"
                    Style="{StaticResource FieldLabel}"
                    Text="Brush size" />
                <Slider
                    AutomationProperties.Name="Brush size"
                    IsSnapToTickEnabled="True"
                    Maximum="150"
                    Minimum="3"
                    TickFrequency="1"
                    Value="{Binding BrushSize}" />

                <Button
                    Margin="0,12,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding RestoreCommand}"
                    Content="Restore"
                    ToolTip="Go back to the automatic result" />

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{Binding CancelCommand}"
                        Content="Cancel" />
                    <Button
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        Command="{Binding ApplyCommand}"
                        Content="Apply"
                        Style="{DynamicResource AccentButtonStyle}" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
