<Window
    x:Class="PicKit.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PicKit.Controls"
    xmlns:vm="clr-namespace:PicKit.ViewModels"
    Title="{Binding WindowTitle}"
    Width="1180"
    Height="760"
    MinWidth="720"
    MinHeight="480"
    AllowDrop="True"
    UseLayoutRounding="True">
    <Window.InputBindings>
        <KeyBinding Command="{Binding OpenCommand}" Gesture="Ctrl+O" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Padding="8,4"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button
                    AutomationProperties.Name="Open image"
                    Command="{Binding OpenCommand}"
                    Style="{StaticResource CommandButton}"
                    ToolTip="Open (Ctrl+O)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;" />
                        <TextBlock Margin="8,0,0,0" Text="Open" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <controls:ImageCanvas x:Name="Canvas" Image="{Binding Image}" />

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding HasImage, Converter={StaticResource InverseBooleanToVisibility}}">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Drop an image here" />
                <TextBlock
                    Margin="0,8,0,12"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SecondaryText}"
                    Text="or" />
                <Button
                    HorizontalAlignment="Center"
                    Command="{Binding OpenCommand}"
                    Content="Open an image"
                    Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="12,6"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding StatusText}" />
        </Border>
    </Grid>
</Window>
