<Window
    x:Class="PicKit.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:batch="clr-namespace:PicKit.Core.Batch;assembly=PicKit.Core"
    xmlns:controls="clr-namespace:PicKit.Controls"
    xmlns:vm="clr-namespace:PicKit.ViewModels"
    Title="{Binding WindowTitle}"
    Width="1180"
    Height="760"
    MinWidth="760"
    MinHeight="480"
    AllowDrop="True"
    UseLayoutRounding="True">
    <Window.InputBindings>
        <KeyBinding Command="{Binding OpenCommand}" Gesture="Ctrl+O" />
        <KeyBinding Command="{Binding SaveCommand}" Gesture="Ctrl+S" />
        <KeyBinding Command="{Binding CopyCommand}" Gesture="Ctrl+C" />
        <KeyBinding Command="{Binding PasteCommand}" Gesture="Ctrl+V" />
        <KeyBinding Command="{Binding SaveAsCommand}" Gesture="Ctrl+Shift+S" />
        <KeyBinding Command="{Binding Editor.UndoCommand}" Gesture="Ctrl+Z" />
        <KeyBinding Command="{Binding Editor.RedoCommand}" Gesture="Ctrl+Y" />
        <KeyBinding Command="{Binding Editor.RedoCommand}" Gesture="Ctrl+Shift+Z" />
        <KeyBinding Command="{Binding Editor.CancelCommand}" Gesture="Escape" />
        <KeyBinding Command="{Binding Editor.ApplyPendingCommand}" Gesture="Enter" />
        <KeyBinding Command="{Binding Editor.DeleteSelectionCommand}" Gesture="Delete" />
        <KeyBinding Command="{Binding NewTabCommand}" Gesture="Ctrl+T" />
        <KeyBinding Command="{Binding CloseCurrentTabCommand}" Gesture="Ctrl+W" />
        <KeyBinding Command="{Binding NextTabCommand}" Gesture="Ctrl+Tab" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Command bar  -->
        <Border
            Padding="8,4"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button
                        AutomationProperties.Name="Open image"
                        Command="{Binding OpenCommand}"
                        Style="{StaticResource CommandButton}"
                        ToolTip="Open (Ctrl+O)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE838;" />
                            <TextBlock Margin="8,0,0,0" Text="Open" />
                        </StackPanel>
                    </Button>

                    <Button
                        AutomationProperties.Name="Settings"
                        Click="OnOpenSettings"
                        Style="{StaticResource CommandButton}"
                        ToolTip="Settings">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE713;" />
                    </Button>

                    <Rectangle
                        Width="1"
                        Margin="8,6"
                        Fill="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Visibility="{Binding ShowsEditorCommands, Converter={StaticResource BooleanToVisibility}}" />

                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowsEditorCommands, Converter={StaticResource BooleanToVisibility}}">
                        <RadioButton
                            Content="Edit"
                            GroupName="EditorTabs"
                            IsChecked="{Binding Editor.SelectedTab, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:EditorTab.Edit}}"
                            Style="{StaticResource PivotTab}" />
                        <RadioButton
                            Content="Tools"
                            GroupName="EditorTabs"
                            IsChecked="{Binding Editor.SelectedTab, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:EditorTab.Tools}}"
                            Style="{StaticResource PivotTab}" />
                        <RadioButton
                            Content="Resize for"
                            GroupName="EditorTabs"
                            IsChecked="{Binding Editor.SelectedTab, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:EditorTab.ResizeFor}}"
                            Style="{StaticResource PivotTab}" />
                    </StackPanel>
                </StackPanel>

                <Grid
                    Grid.Column="1"
                    MaxWidth="320"
                    Margin="12,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding ShowsEditorCommands, Converter={StaticResource BooleanToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="0,0,6,0"
                        FontSize="12"
                        Opacity="0.7"
                        Style="{StaticResource IconText}"
                        Text="&#xE70F;" />
                    <TextBox
                        x:Name="RenameBar"
                        Grid.Column="1"
                        MinWidth="160"
                        AutomationProperties.Name="Image name"
                        LostKeyboardFocus="OnRenameBarLostFocus"
                        PreviewKeyDown="OnRenameBarKeyDown"
                        Text="{Binding EditableName, Mode=OneWay}"
                        TextAlignment="Center"
                        ToolTip="Rename this image" />
                </Grid>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Visibility="{Binding ShowsEditorCommands, Converter={StaticResource BooleanToVisibility}}">
                    <Button
                        AutomationProperties.Name="Undo"
                        Command="{Binding Editor.UndoCommand}"
                        Style="{StaticResource CommandButton}"
                        ToolTip="{Binding Editor.UndoToolTip}"
                        ToolTipService.ShowOnDisabled="True">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE7A7;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Redo"
                        Command="{Binding Editor.RedoCommand}"
                        Style="{StaticResource CommandButton}"
                        ToolTip="{Binding Editor.RedoToolTip}"
                        ToolTipService.ShowOnDisabled="True">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE7A6;" />
                    </Button>

                    <Rectangle
                        Width="1"
                        Margin="8,6"
                        Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <Button
                        AutomationProperties.Name="Copy"
                        Command="{Binding CopyCommand}"
                        Style="{StaticResource CommandButton}"
                        ToolTip="Copy image (Ctrl+C)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" />
                            <TextBlock Margin="8,0,0,0" Text="Copy" />
                        </StackPanel>
                    </Button>
                    <Button
                        Margin="0,0,6,0"
                        AutomationProperties.Name="More copy options"
                        Click="OnDropDownMenu"
                        Style="{StaticResource CommandButton}"
                        ToolTip="More copy options">
                        <TextBlock FontSize="12" Style="{StaticResource IconText}" Text="&#xE70D;" />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding CopyCommand}" Header="Copy" InputGestureText="Ctrl+C" />
                                <MenuItem Command="{Binding CopyAsPngCommand}" Header="Copy as PNG" />
                                <MenuItem Command="{Binding CopyAsJpegCommand}" Header="Copy as JPEG" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button
                        Padding="14,5"
                        AutomationProperties.Name="Save"
                        Command="{Binding SaveCommand}"
                        Content="Save"
                        Style="{DynamicResource AccentButtonStyle}"
                        ToolTip="Save (Ctrl+S)" />
                    <Button
                        Margin="4,0,0,0"
                        AutomationProperties.Name="More save options"
                        Click="OnDropDownMenu"
                        Style="{StaticResource CommandButton}"
                        ToolTip="More save options">
                        <TextBlock FontSize="12" Style="{StaticResource IconText}" Text="&#xE70D;" />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding SaveCopyCommand}" Header="Save Copy" />
                                <MenuItem
                                    Command="{Binding SaveAsCommand}"
                                    Header="Save As..."
                                    InputGestureText="Ctrl+Shift+S" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Tabs  -->
        <Border
            Grid.Row="1"
            Padding="6,3,6,0"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Visibility="{Binding HasTabs, Converter={StaticResource BooleanToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MaxWidth="1600" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ListBox
                    x:Name="TabStrip"
                    AutomationProperties.Name="Open images"
                    ItemContainerStyle="{StaticResource DocumentTabItem}"
                    ItemsSource="{Binding Tabs}"
                    ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding SelectedTab}"
                    SelectionChanged="OnTabSelected"
                    Style="{StaticResource PlainList}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Name}">
                                <Button
                                    Margin="6,0,0,0"
                                    AutomationProperties.Name="Close tab"
                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource TabCloseButton}"
                                    ToolTip="Close tab (Ctrl+W)">
                                    <TextBlock FontSize="9" Style="{StaticResource IconText}" Text="&#xE711;" />
                                </Button>
                                <TextBlock
                                    MaxWidth="170"
                                    VerticalAlignment="Center"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button
                    Grid.Column="1"
                    Margin="4,0,0,3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="New tab"
                    Command="{Binding NewTabCommand}"
                    Style="{StaticResource CommandButton}"
                    ToolTip="New tab (Ctrl+T)">
                    <TextBlock FontSize="12" Style="{StaticResource IconText}" Text="&#xE710;" />
                </Button>
            </Grid>
        </Border>

        <!--  Body  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Left rail: tools, or destinations on the "Resize for" tab  -->
            <Border
                Width="172"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                IsEnabled="{Binding Editor.IsIdle}"
                Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibility}}">
                <Grid Margin="6,8">
                    <ListBox
                        AutomationProperties.Name="Tools"
                        ItemContainerStyle="{StaticResource RailItem}"
                        ItemsSource="{Binding Editor.EditTools}"
                        SelectedItem="{Binding Editor.ActiveTool}"
                        Style="{StaticResource PlainList}"
                        Visibility="{Binding Editor.SelectedTab, Converter={StaticResource EqualsToVisibility}, ConverterParameter={x:Static vm:EditorTab.Edit}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel AutomationProperties.Name="{Binding Name}" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="{Binding Glyph}" />
                                    <TextBlock
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ListBox
                        AutomationProperties.Name="Utilities"
                        ItemContainerStyle="{StaticResource RailItem}"
                        ItemsSource="{Binding Editor.UtilityTools}"
                        SelectedItem="{Binding Editor.ActiveTool}"
                        Style="{StaticResource PlainList}"
                        Visibility="{Binding Editor.SelectedTab, Converter={StaticResource EqualsToVisibility}, ConverterParameter={x:Static vm:EditorTab.Tools}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel AutomationProperties.Name="{Binding Name}" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="{Binding Glyph}" />
                                    <TextBlock
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ListBox
                        AutomationProperties.Name="Destinations"
                        IsSynchronizedWithCurrentItem="False"
                        ItemContainerStyle="{StaticResource RailItem}"
                        ItemsSource="{Binding Editor.Presets.Destinations}"
                        SelectedItem="{Binding Editor.Presets.SelectedPreset}"
                        Style="{StaticResource PlainList}"
                        Visibility="{Binding Editor.SelectedTab, Converter={StaticResource EqualsToVisibility}, ConverterParameter={x:Static vm:EditorTab.ResizeFor}}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="12,10,0,4"
                                            Style="{StaticResource SecondaryText}"
                                            Text="{Binding Name}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock AutomationProperties.Name="{Binding Name}" Text="{Binding Name}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!--  Canvas  -->
            <Grid Grid.Column="1">
                <controls:ImageCanvas
                    x:Name="Canvas"
                    AutomationProperties.Name="Image"
                    IsHitTestVisible="{Binding Editor.IsIdle}"
                    PreviewMouseLeftButtonDown="OnCanvasPressed"
                    Document="{Binding Editor.Document}"
                    Tool="{Binding Editor.CanvasTool}" />

                <Canvas ClipToBounds="True">
                    <TextBox
                        x:Name="TextEntry"
                        MinWidth="40"
                        Padding="0"
                        AcceptsReturn="True"
                        AutomationProperties.Name="Text to add"
                        Background="Transparent"
                        BorderThickness="0"
                        FontFamily="Segoe UI"
                        LostKeyboardFocus="OnTextEntryLostFocus"
                        PreviewKeyDown="OnTextEntryKeyDown"
                        TextChanged="OnTextEntryChanged"
                        Visibility="Collapsed" />
                </Canvas>

                <ScrollBar
                    x:Name="VerticalBar"
                    Margin="0,0,0,14"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="Scroll up and down"
                    Orientation="Vertical"
                    Scroll="OnScrollBarMoved"
                    Style="{StaticResource CanvasScrollBar}"
                    Visibility="Collapsed" />
                <ScrollBar
                    x:Name="HorizontalBar"
                    Margin="0,0,14,0"
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="Scroll left and right"
                    Orientation="Horizontal"
                    Scroll="OnScrollBarMoved"
                    Style="{StaticResource CanvasScrollBar}"
                    Visibility="Collapsed" />

                <Border
                    Margin="0,12,0,0"
                    Padding="14,8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding IsWaitingImage, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,14,0"
                            VerticalAlignment="Center"
                            Text="This image isn't saved yet" />
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding KeepWaitingCommand}"
                            Content="Save"
                            Style="{DynamicResource AccentButtonStyle}" />
                        <Button Command="{Binding TrashWaitingCommand}" Content="Trash" />
                    </StackPanel>
                </Border>

                <ProgressBar
                    VerticalAlignment="Top"
                    IsIndeterminate="True"
                    Visibility="{Binding Editor.IsBusy, Converter={StaticResource BooleanToVisibility}}" />

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasImage, Converter={StaticResource InverseBooleanToVisibility}}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Drop an image here" />
                    <TextBlock
                        Margin="0,8,0,12"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SecondaryText}"
                        Text="or" />
                    <Button
                        HorizontalAlignment="Center"
                        Command="{Binding OpenCommand}"
                        Content="Open an image"
                        Style="{DynamicResource AccentButtonStyle}" />
                    <TextBlock
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SecondaryText}"
                        Text="You can also paste an image from your clipboard." />
                    <Button
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Command="{Binding PasteCommand}"
                        Content="Paste image"
                        Visibility="{Binding CanPasteFromClipboard, Converter={StaticResource BooleanToVisibility}}" />

                    <StackPanel
                        MaxWidth="320"
                        Margin="0,24,0,0"
                        Visibility="{Binding HasRecentImages, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock
                            Margin="0,0,0,4"
                            HorizontalAlignment="Center"
                            Style="{StaticResource SecondaryText}"
                            Text="Recent" />
                        <ItemsControl Focusable="False" ItemsSource="{Binding RecentImages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        AutomationProperties.Name="{Binding Name}"
                                        Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource CommandButton}"
                                        ToolTip="{Binding Path}">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <Border
                    Margin="0,0,0,16"
                    Padding="14,7"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    IsHitTestVisible="False"
                    Visibility="{Binding NoticeText, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock AutomationProperties.LiveSetting="Polite" Text="{Binding NoticeText}" />
                </Border>
            </Grid>

            <!--  Contextual panel  -->
            <Border
                x:Name="ToolPanel"
                Grid.Column="2"
                Width="288"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                IsEnabled="{Binding Editor.IsIdle}"
                PreviewMouseLeftButtonUp="OnToolPanelMouseUp"
                Visibility="{Binding Editor.HasToolPanel, Converter={StaticResource BooleanToVisibility}}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,14">
                        <TextBlock
                            Margin="0,0,0,14"
                            Style="{StaticResource PanelHeading}"
                            Text="{Binding Editor.ActiveTool.Name}" />
                        <ContentControl Content="{Binding Editor.ActiveTool}" Focusable="False" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!--  A batch or rename job takes over the body of the window  -->
        <Border
            Grid.Row="2"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            Visibility="{Binding HasPage, Converter={StaticResource BooleanToVisibility}}">
            <ContentControl Content="{Binding Page}" Focusable="False" />
        </Border>

        <!--  Shown when several images are open  -->
        <Border
            Grid.Row="3"
            Padding="8,4"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{Binding HasMultipleImages, Converter={StaticResource BooleanToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button
                        Margin="6,0,0,0"
                        Command="{Binding BatchAllCommand}"
                        CommandParameter="{x:Static batch:BatchOperation.Compress}"
                        Content="Compress all" />
                    <Button
                        Margin="6,0,0,0"
                        Command="{Binding BatchAllCommand}"
                        CommandParameter="{x:Static batch:BatchOperation.Resize}"
                        Content="Resize all" />
                    <Button
                        Margin="6,0,0,0"
                        Command="{Binding BatchAllCommand}"
                        CommandParameter="{x:Static batch:BatchOperation.Convert}"
                        Content="Convert all" />
                    <Button
                        Margin="6,0,0,0"
                        Command="{Binding RenameAllCommand}"
                        Content="Rename all" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  Status bar  -->
        <Border
            Grid.Row="4"
            Padding="12,2"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Style="{StaticResource SecondaryText}"
                    Text="{Binding StatusText}" />

                <StackPanel
                    DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibility}}">
                    <Button
                        AutomationProperties.Name="Zoom out"
                        Command="{Binding ZoomOutCommand, ElementName=Canvas}"
                        Style="{StaticResource CommandButton}"
                        ToolTip="Zoom out (Ctrl+Minus)">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE71F;" />
                    </Button>
                    <TextBlock
                        Width="48"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ZoomLevel"
                        Text="{Binding ZoomText, ElementName=Canvas}"
                        TextAlignment="Center" />
                    <Button
                        AutomationProperties.Name="Zoom in"
                        Command="{Binding ZoomInCommand, ElementName=Canvas}"
                        Style="{StaticResource CommandButton}"
                        ToolTip="Zoom in (Ctrl+Plus)">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8A3;" />
                    </Button>
                    <Button
                        Margin="4,0,0,0"
                        AutomationProperties.Name="Fit to window"
                        Command="{Binding FitCommand, ElementName=Canvas}"
                        Style="{StaticResource CommandButton}"
                        ToolTip="Fit to window (Ctrl+0)">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE9A6;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Actual size"
                        Command="{Binding ActualSizeCommand, ElementName=Canvas}"
                        Style="{StaticResource CommandButton}"
                        ToolTip="Actual size (Ctrl+1)">
                        <TextBlock FontSize="12" Text="1:1" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
