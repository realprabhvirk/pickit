<Window
    x:Class="PicKit.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="clr-namespace:PicKit.Core.Settings;assembly=PicKit.Core"
    Title="PicKit Settings"
    Width="480"
    Height="640"
    MinWidth="400"
    MinHeight="400"
    ShowInTaskbar="False"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource PanelHeading}"
                Text="General" />
            <CheckBox Content="Ask before replacing a file" IsChecked="{Binding ConfirmOverwrite}" />
            <CheckBox Content="Remember window size and position" IsChecked="{Binding RememberWindow}" />

            <TextBlock
                Margin="0,10,0,4"
                Style="{StaticResource FieldLabel}"
                Text="Appearance" />
            <StackPanel Orientation="Horizontal">
                <RadioButton
                    Margin="0,0,16,0"
                    Content="System"
                    GroupName="Appearance"
                    IsChecked="{Binding Appearance, Converter={StaticResource Equals}, ConverterParameter={x:Static settings:AppAppearance.System}}" />
                <RadioButton
                    Margin="0,0,16,0"
                    Content="Light"
                    GroupName="Appearance"
                    IsChecked="{Binding Appearance, Converter={StaticResource Equals}, ConverterParameter={x:Static settings:AppAppearance.Light}}" />
                <RadioButton
                    Content="Dark"
                    GroupName="Appearance"
                    IsChecked="{Binding Appearance, Converter={StaticResource Equals}, ConverterParameter={x:Static settings:AppAppearance.Dark}}" />
            </StackPanel>

            <TextBlock
                Margin="0,22,0,8"
                Style="{StaticResource PanelHeading}"
                Text="Image" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding JpegQuality, StringFormat=JPEG quality: {0:0}}" />
            <Slider
                AutomationProperties.Name="JPEG quality"
                IsSnapToTickEnabled="True"
                Maximum="100"
                Minimum="30"
                TickFrequency="1"
                Value="{Binding JpegQuality}" />
            <TextBlock
                Margin="0,8,0,4"
                Style="{StaticResource FieldLabel}"
                Text="{Binding WebPQuality, StringFormat=WebP quality: {0:0}}" />
            <Slider
                AutomationProperties.Name="WebP quality"
                IsSnapToTickEnabled="True"
                Maximum="100"
                Minimum="30"
                TickFrequency="1"
                Value="{Binding WebPQuality}" />

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Format for pasted images" />
                    <ComboBox
                        AutomationProperties.Name="Format for pasted images"
                        ItemsSource="{Binding Formats}"
                        SelectedItem="{Binding DefaultFormat}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Behind transparency" />
                    <ComboBox
                        AutomationProperties.Name="Colour behind transparency"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding Backgrounds}"
                        SelectedItem="{Binding Background}" />
                </StackPanel>
            </Grid>

            <TextBlock
                Margin="0,22,0,8"
                Style="{StaticResource PanelHeading}"
                Text="Privacy" />
            <CheckBox Content="Keep camera and location details in copies of JPEG photos" IsChecked="{Binding KeepPhotoDetails}" />
            <TextBlock
                Margin="0,4,0,10"
                Style="{StaticResource BodyHint}"
                Text="Off by default, so files you share don't reveal where they were taken. Details are always removed once you've edited an image." />
            <Button
                HorizontalAlignment="Left"
                Command="{Binding ClearRecentCommand}"
                Content="Clear recent files" />

            <TextBlock
                Margin="0,22,0,8"
                Style="{StaticResource PanelHeading}"
                Text="File Explorer" />
            <CheckBox Content="Show PicKit when right-clicking images" IsChecked="{Binding ExplorerMenu}" />
            <CheckBox Content="List PicKit under Open with" IsChecked="{Binding OpenWith}" />
            <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource BodyHint}"
                Text="On Windows 11, the right-click menu is under Show more options. Your default apps stay as they are. You can choose PicKit as a default in Windows Settings." />

            <TextBlock
                Margin="0,12,0,0"
                Style="{StaticResource BodyHint}"
                Text="{Binding StatusText}"
                Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>
    </ScrollViewer>
</Window>
