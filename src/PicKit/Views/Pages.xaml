<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:batch="clr-namespace:PicKit.Core.Batch;assembly=PicKit.Core"
    xmlns:imaging="clr-namespace:PicKit.Core.Imaging;assembly=PicKit.Core"
    xmlns:vm="clr-namespace:PicKit.ViewModels">

    <DataTemplate DataType="{x:Type vm:BatchViewModel}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="520"
                Margin="24,28"
                HorizontalAlignment="Center">
                <TextBlock
                    Margin="0,0,0,18"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="{Binding Heading}" />

                <StackPanel Visibility="{Binding IsSetup, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel
                        Margin="0,0,0,16"
                        Orientation="Horizontal">
                        <RadioButton
                            Content="Compress"
                            GroupName="BatchOperation"
                            IsChecked="{Binding Operation, Converter={StaticResource Equals}, ConverterParameter={x:Static batch:BatchOperation.Compress}}"
                            Style="{StaticResource PivotTab}" />
                        <RadioButton
                            Content="Resize"
                            GroupName="BatchOperation"
                            IsChecked="{Binding Operation, Converter={StaticResource Equals}, ConverterParameter={x:Static batch:BatchOperation.Resize}}"
                            Style="{StaticResource PivotTab}" />
                        <RadioButton
                            Content="Convert"
                            GroupName="BatchOperation"
                            IsChecked="{Binding Operation, Converter={StaticResource Equals}, ConverterParameter={x:Static batch:BatchOperation.Convert}}"
                            Style="{StaticResource PivotTab}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsCompress, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Quality" />
                        <RadioButton
                            Content="High"
                            GroupName="BatchQuality"
                            IsChecked="{Binding Preset, Converter={StaticResource Equals}, ConverterParameter={x:Static imaging:CompressionPreset.High}}" />
                        <RadioButton
                            Content="Balanced"
                            GroupName="BatchQuality"
                            IsChecked="{Binding Preset, Converter={StaticResource Equals}, ConverterParameter={x:Static imaging:CompressionPreset.Balanced}}" />
                        <RadioButton
                            Content="Small"
                            GroupName="BatchQuality"
                            IsChecked="{Binding Preset, Converter={StaticResource Equals}, ConverterParameter={x:Static imaging:CompressionPreset.Small}}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsResize, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Mode" />
                        <RadioButton
                            Content="Scale"
                            GroupName="BatchResize"
                            IsChecked="{Binding ResizeMode, Converter={StaticResource Equals}, ConverterParameter={x:Static imaging:ResizeMode.Scale}}" />
                        <RadioButton
                            Content="Fit"
                            GroupName="BatchResize"
                            IsChecked="{Binding ResizeMode, Converter={StaticResource Equals}, ConverterParameter={x:Static imaging:ResizeMode.Fit}}" />
                        <RadioButton
                            Content="Crop"
                            GroupName="BatchResize"
                            IsChecked="{Binding ResizeMode, Converter={StaticResource Equals}, ConverterParameter={x:Static imaging:ResizeMode.CropToFill}}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            Style="{StaticResource WarningText}"
                            Text="{Binding CropNote}"
                            Visibility="{Binding CropNote, Converter={StaticResource NullToCollapsed}}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Width" />
                                <TextBox AutomationProperties.Name="Width" Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Height" />
                                <TextBox AutomationProperties.Name="Height" Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <CheckBox
                            Margin="0,10,0,0"
                            Content="Keep aspect ratio"
                            IsChecked="{Binding KeepAspect}"
                            Visibility="{Binding ShowsKeepAspect, Converter={StaticResource BooleanToVisibility}}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsConvert, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="To" />
                        <ComboBox
                            AutomationProperties.Name="Convert to"
                            DisplayMemberPath="Label"
                            ItemsSource="{Binding Formats}"
                            SelectedItem="{Binding SelectedFormat}" />
                        <TextBlock
                            Margin="0,12,0,4"
                            Style="{StaticResource FieldLabel}"
                            Text="{Binding Quality, StringFormat=Quality: {0:0}}" />
                        <Slider
                            AutomationProperties.Name="Quality"
                            IsSnapToTickEnabled="True"
                            Maximum="100"
                            Minimum="30"
                            TickFrequency="1"
                            Value="{Binding Quality}" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,18,0,4"
                        Style="{StaticResource FieldLabel}"
                        Text="Output" />
                    <RadioButton
                        Content="Same folder"
                        GroupName="BatchOutput"
                        IsChecked="{Binding Output, Converter={StaticResource Equals}, ConverterParameter={x:Static batch:BatchOutput.SameFolder}}" />
                    <RadioButton
                        Content="New folder"
                        GroupName="BatchOutput"
                        IsChecked="{Binding Output, Converter={StaticResource Equals}, ConverterParameter={x:Static batch:BatchOutput.NewFolder}}" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            Content="Choose folder"
                            GroupName="BatchOutput"
                            IsChecked="{Binding Output, Converter={StaticResource Equals}, ConverterParameter={x:Static batch:BatchOutput.ChosenFolder}}" />
                        <Button
                            Margin="12,0,0,0"
                            Command="{Binding ChooseFolderCommand}"
                            Content="Browse..." />
                    </StackPanel>
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource BodyHint}"
                        Text="{Binding ChosenFolder}"
                        Visibility="{Binding ChosenFolder, Converter={StaticResource NullToCollapsed}}" />

                    <CheckBox
                        Margin="0,10,0,0"
                        Content="Preserve filenames"
                        IsChecked="{Binding PreserveNames}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource BodyHint}"
                        Text="Your originals are never replaced. New files always get their own names." />

                    <StackPanel
                        Margin="0,20,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            MinWidth="96"
                            Margin="0,0,8,0"
                            Command="{Binding CloseCommand}"
                            Content="Cancel" />
                        <Button
                            MinWidth="96"
                            Command="{Binding StartCommand}"
                            Content="Start"
                            Style="{DynamicResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Margin="0,0,0,8" Text="{Binding ProgressText}" />
                    <ProgressBar
                        AutomationProperties.Name="Progress"
                        Maximum="{Binding Total}"
                        Value="{Binding Completed}" />
                    <Button
                        MinWidth="96"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Right"
                        Command="{Binding CancelCommand}"
                        Content="Cancel" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsFinished, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" />

                    <ItemsControl
                        Margin="0,12,0,0"
                        Focusable="False"
                        ItemsSource="{Binding Failures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Style="{StaticResource BodyHint}" Text="{Binding Reason}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel
                        Margin="0,16,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            MinWidth="96"
                            Margin="0,0,8,0"
                            Command="{Binding ShowFolderCommand}"
                            Content="Show folder" />
                        <Button
                            MinWidth="96"
                            Command="{Binding CloseCommand}"
                            Content="Done"
                            Style="{DynamicResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:RenameViewModel}">
        <Grid MaxWidth="640" Margin="24,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Margin="0,0,0,18"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{Binding Heading}" />

            <StackPanel Grid.Row="1">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Pattern" />
                <TextBox AutomationProperties.Name="Name pattern" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <Button
                        Margin="0,0,6,0"
                        Command="{Binding InsertTokenCommand}"
                        CommandParameter="{}{name}"
                        Content="Name"
                        ToolTip="The file's current name" />
                    <Button
                        Margin="0,0,6,0"
                        Command="{Binding InsertTokenCommand}"
                        CommandParameter="{}{number}"
                        Content="Number"
                        ToolTip="Counts up for each file" />
                    <Button
                        Command="{Binding InsertTokenCommand}"
                        CommandParameter="{}{date}"
                        Content="Date"
                        ToolTip="The date the file was last changed" />
                </StackPanel>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Start at" />
                        <TextBox AutomationProperties.Name="Start number" Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Digits" />
                        <TextBox AutomationProperties.Name="Number of digits" Text="{Binding PaddingText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <TextBlock
                    Margin="0,12,0,0"
                    Style="{StaticResource WarningText}"
                    Text="{Binding ProblemText}"
                    Visibility="{Binding ProblemText, Converter={StaticResource NullToCollapsed}}" />
                <TextBlock
                    Margin="0,12,0,0"
                    Style="{StaticResource FieldLabel}"
                    Text="Preview" />
            </StackPanel>

            <Border
                Grid.Row="2"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <ListBox
                    AutomationProperties.Name="Preview of new names"
                    ItemsSource="{Binding Preview}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    Style="{StaticResource PlainList}"
                    VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{x:Null}">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter Margin="10,4" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Style="{StaticResource SecondaryText}"
                                        Text="{Binding OldName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="10,0"
                                        Style="{StaticResource IconText}"
                                        FontSize="12"
                                        Text="&#xE72A;" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding NewName}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <TextBlock
                                    Style="{StaticResource WarningText}"
                                    Text="{Binding Problem}"
                                    Visibility="{Binding Problem, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <TextBlock
                    Margin="0,0,0,10"
                    Text="{Binding ResultText}"
                    Visibility="{Binding ResultText, Converter={StaticResource NullToCollapsed}}" />
                <DockPanel LastChildFill="False">
                    <Button
                        Command="{Binding UndoCommand}"
                        Content="Undo Rename"
                        DockPanel.Dock="Left"
                        Visibility="{Binding CanUndoRename, Converter={StaticResource BooleanToVisibility}}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryText}"
                            Text="{Binding ConfirmText}" />
                        <Button
                            MinWidth="96"
                            Margin="0,0,8,0"
                            Command="{Binding CloseCommand}"
                            Content="Close" />
                        <Button
                            MinWidth="96"
                            Command="{Binding RenameCommand}"
                            Content="Rename"
                            Style="{DynamicResource AccentButtonStyle}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
