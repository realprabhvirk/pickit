<Window
    x:Class="PicKit.Views.MessageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PicKit"
    Width="440"
    MinHeight="160"
    MaxHeight="560"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="HeadingText"
            Margin="0,0,0,8"
            FontSize="20"
            FontWeight="SemiBold"
            TextWrapping="Wrap" />

        <TextBlock
            x:Name="BodyText"
            Grid.Row="1"
            Margin="0,0,0,12"
            TextWrapping="Wrap" />

        <Expander
            x:Name="DetailsExpander"
            Grid.Row="2"
            Margin="0,0,0,12"
            Header="Details"
            Visibility="Collapsed">
            <TextBox
                x:Name="DetailsText"
                MaxHeight="180"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="12"
                HorizontalScrollBarVisibility="Auto"
                IsReadOnly="True"
                TextWrapping="NoWrap"
                VerticalScrollBarVisibility="Auto" />
        </Expander>

        <StackPanel
            Grid.Row="3"
            Margin="0,8,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="ConfirmButton"
                MinWidth="96"
                Margin="0,0,8,0"
                Click="OnConfirm"
                IsDefault="True"
                Style="{DynamicResource AccentButtonStyle}"
                Visibility="Collapsed" />
            <Button
                x:Name="CloseButton"
                MinWidth="96"
                Click="OnClose"
                IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
