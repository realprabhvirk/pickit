<Window
    x:Class="PicKit.Views.TransparencyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PicKit"
    Width="400"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24,20">
        <TextBlock
            Margin="0,0,0,8"
            FontSize="20"
            FontWeight="SemiBold"
            Text="Fill the transparent areas?" />
        <TextBlock
            Margin="0,0,0,14"
            Text="JPEG doesn't support transparency. Choose a colour to go behind this image."
            TextWrapping="Wrap" />

        <RadioButton
            x:Name="WhiteOption"
            Content="White"
            GroupName="Fill" />
        <RadioButton
            x:Name="BlackOption"
            Content="Black"
            GroupName="Fill" />
        <StackPanel Orientation="Horizontal">
            <RadioButton
                x:Name="CustomOption"
                Content="Custom"
                GroupName="Fill" />
            <Button
                Margin="12,0,0,0"
                Click="OnChooseColor"
                Content="Choose..." />
            <Border
                x:Name="CustomSwatch"
                Width="24"
                Height="24"
                Margin="8,0,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4" />
        </StackPanel>

        <StackPanel
            Margin="0,20,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                MinWidth="96"
                Margin="0,0,8,0"
                Click="OnContinue"
                Content="Continue"
                IsDefault="True"
                Style="{DynamicResource AccentButtonStyle}" />
            <Button
                MinWidth="96"
                Content="Cancel"
                IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
