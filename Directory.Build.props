<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.1.0</Version>
    <Company>PicKit</Company>
    <Product>PicKit</Product>
    <Copyright>Copyright (c) 2026 PicKit</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- The source tree lives in OneDrive. Keep build output out of it so binaries are
         never synced and OneDrive cannot lock files in the middle of a build. -->
    <UseArtifactsOutput Condition="'$(LOCALAPPDATA)' != ''">true</UseArtifactsOutput>
    <ArtifactsPath Condition="'$(LOCALAPPDATA)' != ''">$(LOCALAPPDATA)\PicKit-build</ArtifactsPath>
  </PropertyGroup>
</Project>
